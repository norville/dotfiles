# =============================================================================
# SSH Client Configuration
# =============================================================================
# Private keys are stored in 1Password; the 1Password SSH agent handles
# authentication. IdentityFile points to the public key — the agent matches
# it to the corresponding private key it holds and signs the challenge.
# IdentitiesOnly prevents the agent from offering other unrelated keys.
# =============================================================================
{{- if eq .machine "workstation" }}

# Workstations use their own 1Password agent — EXCEPT inside an SSH session that
# carries a forwarded agent: IdentityAgent then stays unset, so ssh uses
# $SSH_AUTH_SOCK, i.e. the client's 1Password (approval prompts appear there).
Match exec "[ -z \"$SSH_CONNECTION\" ] || [ ! -S \"$SSH_AUTH_SOCK\" ]"
  {{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  {{- else if eq .chezmoi.os "linux" }}
  IdentityAgent ~/.1password/agent.sock
  {{- end }}
{{- end }}

Host *
  IdentitiesOnly yes  # offer only the keys listed below, not everything in the agent

# Homelab hosts — list shared with yazi's vfs.toml via .chezmoidata sshHosts;
# user/port from .chezmoi.toml [data].
Host {{ .sshHosts | join " " }}
  Port {{ .port }}
  User {{ .user }}
  IdentityFile ~/.ssh/norville_at_chikyu.pub

# Linux workstations running sshd (.chezmoidata sshWorkstations): forward the
# 1Password agent so onward hops (homelab nodes, GitHub) sign on this client.
Host {{ .sshWorkstations | join " " }}
  ForwardAgent yes

Host github.com
  IdentityFile ~/.ssh/norville_at_github.pub

Host codeberg.org
  IdentityFile ~/.ssh/norville_at_codeberg.pub
