            <line>// ============================================</line>
            <line>(?d)@eaDir</line>
            <line>(?d).@__thumb</line>
            <line>(?d).AppleDB</line>
            <line>(?d).AppleDesktop</line>
            <line></line>
            <line>// ============================================</line>
