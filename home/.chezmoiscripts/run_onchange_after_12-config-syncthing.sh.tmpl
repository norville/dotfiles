SYNCTHING_DEFAULTS_EOF

# -----------------------------------------------------------------------------
# Idempotency: skip if the on-disk <defaults> block already matches
# -----------------------------------------------------------------------------
_current="$(mktemp)"
BDB_TEMP_FILES="${BDB_TEMP_FILES:-} ${_current}"
awk '/<defaults>/{f=1} f{print} /<\/defaults>/{exit}' "${_conf}" > "${_current}"

if cmp -s "${_current}" "${_block}"; then
    bdb_success "Syncthing defaults already up to date"
    bdb_end_section
    exit 0
fi

if ! grep -q '<defaults>' "${_conf}"; then
    bdb_error "No <defaults> block found in ${_conf} — refusing to edit"
    bdb_end_section
    exit 1
fi

# -----------------------------------------------------------------------------
# Apply: stop syncthing (edits to config.xml are only read at startup), splice
# in the canonical block, then restart if it had been running.
# -----------------------------------------------------------------------------
_was_running=false
{{- if eq .chezmoi.os "linux" }}
if systemctl --user is-active syncthing.service &>/dev/null; then
    _was_running=true
    bdb_exec "Stopping syncthing" systemctl --user stop syncthing.service
fi
{{- else if eq .chezmoi.os "darwin" }}
if brew services list | awk '$1=="syncthing" && $2=="started"{ok=1} END{exit !ok}'; then
    _was_running=true
    bdb_exec "Stopping syncthing" brew services stop syncthing
fi
{{- end }}

bdb_action "Updating <defaults> block in config.xml"
_new="$(mktemp)"
BDB_TEMP_FILES="${BDB_TEMP_FILES:-} ${_new}"
awk -v blockfile="${_block}" '
    /<defaults>/ && !done {
        while ((getline line < blockfile) > 0) print line
        close(blockfile)
        inblock = 1; done = 1; next
    }
    inblock && /<\/defaults>/ { inblock = 0; next }
    inblock { next }
    { print }
' "${_conf}" > "${_new}"

# Preserve ownership/permissions by writing back in place.
cat "${_new}" > "${_conf}"
bdb_success "Syncthing defaults applied"

{{- if eq .chezmoi.os "linux" }}
if "${_was_running}"; then
    bdb_exec "Starting syncthing" systemctl --user start syncthing.service
fi
{{- else if eq .chezmoi.os "darwin" }}
if "${_was_running}"; then
    bdb_exec "Starting syncthing" brew services start syncthing
fi
{{- end }}

bdb_end_section

exit 0
