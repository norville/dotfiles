            <line>// ============================================</line>
            <line>(?d)$RECYCLE.BIN</line>
            <line>(?d)System Volume Information</line>
            <line>(?d)Trash-*</line>
            <line>(?d)Recovery</line>
            <line>(?d)Windows.old</line>
            <line>(?d)$WINDOWS.~BT</line>
            <line>(?d)$WINDOWS.~LS</line>
            <line></line>
            <line>// ============================================</line>
            <line>// LINUX/UNIX SYSTEM DIRECTORIES</line>
            <line>// ============================================</line>
            <line>(?d)lost+found</line>
