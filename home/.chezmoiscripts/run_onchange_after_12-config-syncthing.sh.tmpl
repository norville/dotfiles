#!/usr/bin/env bash
# =============================================================================
# Chezmoi Script: Configure Syncthing defaults
# =============================================================================
# Enforces the <defaults> template (default folder, default device and the
# default ignore patterns) in syncthing's config.xml. The rest of config.xml is
# owned by syncthing (device IDs, GUI credentials, API key, live folders) and is
# NOT tracked by chezmoi — this script only owns the <defaults> block.
#
# run_onchange: re-runs only when this file's content changes (i.e. when the
# canonical block below is edited) or on a fresh machine — never on every apply,
# so it never fights syncthing's own rewrites of the surrounding file.
#
# Workstation (linux/darwin) and terminal (linux) machines only. Idempotent:
# skips when the on-disk block already matches, restarting syncthing only when a
# change is actually applied.
#
# Execution: chezmoi apply (only when this file's content changes)
# Location:  .chezmoiscripts/run_onchange_after_12-config-syncthing.sh.tmpl
# =============================================================================
{{- /* Syncthing scope: workstation + terminal, never servers. */ -}}
{{- if not (or (eq .machine "workstation") (eq .machine "terminal")) }}
exit 0
{{- end }}

source "${HELPERS}"

bdb_script_init "${BASH_SOURCE[0]}"

bdb_begin_section "Syncthing defaults"

# Nothing to configure if syncthing was never installed (e.g. declined on a
# terminal). 09-install-syncthing runs first, so on a fresh apply it is present.
if ! bdb_has_cmd "syncthing"; then
    bdb_warn "Skipping — syncthing is not installed"
    bdb_end_section
    exit 0
fi

# -----------------------------------------------------------------------------
# Locate config.xml (cross-platform via `syncthing paths`)
# -----------------------------------------------------------------------------
_conf="$(syncthing paths 2>/dev/null |
    awk '/^Configuration file:/{getline; gsub(/^[ \t]+/, ""); print; exit}')"

if [[ -z "${_conf}" ]]; then
    # Fallback to the documented default locations.
    {{- if eq .chezmoi.os "darwin" }}
    _conf="${HOME}/Library/Application Support/Syncthing/config.xml"
    {{- else }}
    _conf="${XDG_STATE_HOME:-${HOME}/.local/state}/syncthing/config.xml"
    {{- end }}
fi
bdb_var "Config file" "${_conf}"

# Create a default config if syncthing has never generated one yet. `generate`
# writes config + keys without starting the daemon and is a no-op if present.
if [[ ! -f "${_conf}" ]]; then
    bdb_exec "Generating initial syncthing config" \
        syncthing generate --config "$(dirname "${_conf}")"
fi

# -----------------------------------------------------------------------------
# Canonical <defaults> block
# -----------------------------------------------------------------------------
# Quoted heredoc: patterns such as $RECYCLE.BIN, $WINDOWS.~BT and ~$* must NOT be
# shell-expanded. Indentation matches syncthing's own (4 spaces for <defaults>).
_block="$(mktemp)"
# Register temp files with bdb_cleanup (do NOT set an EXIT trap here — that
# would override the one bdb_script_init installs for logging cleanup).
BDB_TEMP_FILES="${BDB_TEMP_FILES:-} ${_block}"

cat > "${_block}" <<'SYNCTHING_DEFAULTS_EOF'
