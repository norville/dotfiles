// ────────────── Gestures & Overview ──────────────
gestures { hot-corners      { off; }; }
overview { workspace-shadow { off; }; }

// ────────────── Layout ──────────────
layout {
{{- if lookPath "noctalia" }}
    // noctalia-shell renders its wallpaper as a compositor layer;
    // must be transparent or the wallpaper is hidden
    background-color      "transparent"
{{- end }}
    center-focused-column "never"
    gaps                  12
    border                { off; }
    focus-ring {
        width             4
        active-color      "#82aaff"
        inactive-color    "#545c7e"
    }
}

// ────────────── Appearance & Environment ──────────────
prefer-no-csd
screenshot-path null

environment {
    ELECTRON_OZONE_PLATFORM_HINT        "auto"
    QT_QPA_PLATFORM                     "wayland"
    QT_QPA_PLATFORMTHEME                "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    XDG_CURRENT_DESKTOP                 "niri"
    XDG_SESSION_TYPE                    "wayland"
}

cursor {
    xcursor-theme "capitaine-cursors"
    xcursor-size  24
}

// Window background blur (used by the noctalia background-effect rules)
blur {
    passes      2     // more passes = stronger blur (default: 3)
    offset      3.0   // sample distance per pass (default: 3.0)
    noise       0.03  // grain overlay (default: 0.02)
    saturation  1.0   // color saturation boost (default: 1.5)
}

// Allows notification actions and window activation from Noctalia.
debug { honor-xdg-activation-with-invalid-serial; }

hotkey-overlay { skip-at-startup; }
