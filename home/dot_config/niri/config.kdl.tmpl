// ────────────── NIRI ──────────────

{{ if lookPath "noctalia" -}}
// ────────────── Noctalia Shell ──────────────
// ./cfg/*.kdl files are managed by the Noctalia package,
// overridden includes are commented out.
// only load them when noctalia is installed
include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
//include "./cfg/keybinds.kdl"
//include "./cfg/input.kdl"
//include "./cfg/display.kdl"
//include "./cfg/layout.kdl"
//include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

{{ end -}}
// ────────────── Input ──────────────
input {
    workspace-auto-back-and-forth
    touchpad                      { off; }
    trackpoint                    { off; }
    mouse                         { natural-scroll; }
    keyboard {
        // 'us' layout + deadkeys for international characters
        xkb {
            layout  "us"
            model   "pc105"
            variant "altgr-intl"
            options "eurosign:5"
        }
    }
}

// ────────────── Outputs ──────────────
output "DP-1" {
    // main display, right position, default orientation
    focus-at-startup
    mode              "2560x1440@59.951"
    position          x=1080 y=0
    layout {
        default-column-width { proportion 0.5; }
        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
            proportion 1.0
        }
        preset-window-heights {
            proportion 0.5
            proportion 1.0
        }
    }
}

output "HDMI-A-1" {
    // secondary monitor, left position, vertical orientation
    variable-refresh-rate
    mode                  "1920x1080@60"
    transform             "90"
    position              x=0 y=0
    layout {
        default-column-width { proportion 1.0; }
        preset-column-widths { proportion 1.0; }
        preset-window-heights {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
            proportion 1.0
        }
    }
}

// ────────────── Gestures & Overview ──────────────
gestures { hot-corners { off; }; }
overview { workspace-shadow { off; }; }

// ────────────── Layout ──────────────
layout {
{{- if lookPath "noctalia" }}
    // noctalia-shell renders its wallpaper as a compositor layer;
    // must be transparent or the wallpaper is hidden
    background-color      "transparent"
{{- end }}
    center-focused-column "never"
    gaps                  12
    border                { off; }
    focus-ring {
        width           4
        active-color    "#82aaff"
        inactive-color  "#545c7e"
    }
}

// ────────────── Window Rules ──────────────
// Disable border background
// https://niri-wm.github.io/niri/FAQ.html#why-are-transparent-windows-tinted-why-is-the-borderfocus-ring-showing-up-through-semitransparent-windows
window-rule { draw-border-with-background false; }

// Rounded corners for a modern look.
window-rule {
    geometry-corner-radius  12
    clip-to-geometry        true
}
{{- if lookPath "noctalia" }}

// Noctalia: floating settings window
window-rule {
    match                 app-id="dev.noctalia.Noctalia"
    open-floating         true
    default-column-width  { fixed 1080; }
    default-window-height { fixed 920; }
}

// Config wallpaper
layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
{{- end }}

// Default terminal: Kitty
window-rule {
    match           app-id="kitty"
    open-on-output  "DP-1"
}

// Default browser: Brave
window-rule {
    match           app-id="brave-browser"
    open-on-output  "HDMI-A-1"
}

// 1Password: treat all windows as floating
window-rule {
    match           app-id="1password"
    open-on-output  "DP-1"
    open-floating   true
    open-focused    true
    shadow          { on; }
}

// ────────────── Startup Applications ──────────────
// sleep 3: give the compositor and Noctalia shell time to fully initialize before opening clients
spawn-sh-at-startup "sleep 3; brave"
spawn-sh-at-startup "sleep 3; kitty"

// ────────────── Key Bindings ──────────────
binds {

    // ─── Niri ───

    // Toggle the Important Hotkeys dialog
    Mod+Shift+Escape                                                            { show-hotkey-overlay; }

    // Window Focus
    Mod+Q                                                                       { close-window; }
    Mod+Shift+V                                                                 { switch-focus-between-floating-and-tiling; }
    Mod+Left                                                                    { focus-column-left; }
    Mod+H                                                                       { focus-column-left; }
    Mod+Right                                                                   { focus-column-right; }
    Mod+L                                                                       { focus-column-right; }
    Mod+Up                                                                      { focus-window-up; }
    Mod+K                                                                       { focus-window-up; }
    Mod+Down                                                                    { focus-window-down; }
    Mod+J                                                                       { focus-window-down; }
    Mod+Ctrl+Left                                                               { move-column-left; }
    Mod+Ctrl+H                                                                  { move-column-left; }
    Mod+Ctrl+Right                                                              { move-column-right; }
    Mod+Ctrl+L                                                                  { move-column-right; }
    Mod+Ctrl+UP                                                                 { move-window-up; }
    Mod+Ctrl+K                                                                  { move-window-up; }
    Mod+Ctrl+Down                                                               { move-window-down; }
    Mod+Ctrl+J                                                                  { move-window-down; }
    Mod+Home                                                                    { focus-column-first; }
    Mod+End                                                                     { focus-column-last; }
    Mod+Ctrl+Home                                                               { move-column-to-first; }
    Mod+Ctrl+End                                                                { move-column-to-last; }

    // Monitor focus
    Mod+Shift+Left                                                              { focus-monitor-left; }
    Mod+Shift+H                                                                 { focus-monitor-left; }
    Mod+Shift+Right                                                             { focus-monitor-right; }
    Mod+Shift+L                                                                 { focus-monitor-right; }
    Mod+Shift+UP                                                                { focus-monitor-up; }
    Mod+Shift+K                                                                 { focus-monitor-up; }
    Mod+Shift+Down                                                              { focus-monitor-down; }
    Mod+Shift+J                                                                 { focus-monitor-down; }
    Mod+Shift+Ctrl+Left                                                         { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+H                                                            { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right                                                        { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+L                                                            { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+UP                                                           { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+K                                                            { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down                                                         { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+J                                                            { move-column-to-monitor-down; }

    // Workspace Focus
    Mod+1                                                                       { focus-workspace 1; }
    Mod+2                                                                       { focus-workspace 2; }
    Mod+3                                                                       { focus-workspace 3; }
    Mod+4                                                                       { focus-workspace 4; }
    Mod+5                                                                       { focus-workspace 5; }
    Mod+6                                                                       { focus-workspace 6; }
    Mod+7                                                                       { focus-workspace 7; }
    Mod+8                                                                       { focus-workspace 8; }
    Mod+9                                                                       { focus-workspace 9; }
    Mod+Ctrl+1                                                                  { move-column-to-workspace 1; }
    Mod+Ctrl+2                                                                  { move-column-to-workspace 2; }
    Mod+Ctrl+3                                                                  { move-column-to-workspace 3; }
    Mod+Ctrl+4                                                                  { move-column-to-workspace 4; }
    Mod+Ctrl+5                                                                  { move-column-to-workspace 5; }
    Mod+Ctrl+6                                                                  { move-column-to-workspace 6; }
    Mod+Ctrl+7                                                                  { move-column-to-workspace 7; }
    Mod+Ctrl+8                                                                  { move-column-to-workspace 8; }
    Mod+Ctrl+9                                                                  { move-column-to-workspace 9; }
    Mod+Tab                                                                     { focus-workspace-previous; }
    Mod+Page_Down                                                               { focus-workspace-down; }
    Mod+Page_Up                                                                 { focus-workspace-up; }
    Mod+Ctrl+Page_Down                                                          { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up                                                            { move-column-to-workspace-up; }

    // Window Size
    Mod+C                                                                       { center-column; }
    Mod+Ctrl+C                                                                  { center-visible-columns; }
    Mod+R                                                                       { switch-preset-column-width; }
    Mod+Shift+R                                                                 { switch-preset-window-height; }
    Mod+F                                                                       { maximize-column; }
    Mod+Shift+F                                                                 { fullscreen-window; }
    Mod+Ctrl+F                                                                  { expand-column-to-available-width; }
    Mod+M                                                                       { maximize-window-to-edges; }
    Mod+Minus                                                                   { set-column-width "-10%"; }
    Mod+Equal                                                                   { set-column-width "+10%"; }
    Mod+Shift+Minus                                                             { set-window-height "-10%"; }
    Mod+Shift+Equal                                                             { set-window-height "+10%"; }

    // Mode
    Mod+T                                                                       { toggle-window-floating; }
    Mod+W                                                                       { toggle-column-tabbed-display; }
    Mod+O                 repeat=false                                          { toggle-overview; }

    // Screenshot
    Mod+Shift+1                                                                 { screenshot; }
    Mod+Shift+2                                                                 { screenshot-screen; }
    Mod+Shift+3                                                                 { screenshot-window; }

    // Emergency Escape Key
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE            allow-inhibiting=false                                { toggle-keyboard-shortcuts-inhibit; }
{{- if lookPath "noctalia" }}

    // Media Controls
    XF86AudioRaiseVolume  allow-when-locked=true                                { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true                                { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         allow-when-locked=true                                { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true                                { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext         allow-when-locked=true                                { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev         allow-when-locked=true                                { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay         allow-when-locked=true                                { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause        allow-when-locked=true                                { spawn-sh "noctalia msg media toggle"; }

    // Brightness Controls
    XF86MonBrightnessUp   allow-when-locked=true                                { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true                                { spawn-sh "noctalia msg brightness-down"; }

    // ─── Noctalia ───

    // Panels
    Mod+Space             hotkey-overlay-title="Toggle App Launcher"            { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Alt+Return        hotkey-overlay-title="Toggle Wallpaper Selector"      { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Comma             hotkey-overlay-title="Toggle Settings"                { spawn-sh "noctalia msg settings-toggle"; }
    Mod+S                 hotkey-overlay-title="Toggle Control Center"          { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+N                 hotkey-overlay-title="Toggle Notifications"           { spawn-sh "noctalia msg notification-invoke-latest"; }
    Mod+Alt+N             hotkey-overlay-title="Clear Notifications"            { spawn-sh "noctalia msg notification-clear-history"; }
    Alt+Tab               hotkey-overlay-title="Window Switcher"                { spawn-sh "noctalia msg window-switcher"; }

    // Exit / Power
    Mod+Alt+Q             hotkey-overlay-title="Toggle Session Menu"            { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Alt+L             hotkey-overlay-title="Lock Screen"                    { spawn-sh "noctalia msg session lock"; }
{{- end }}
    Mod+Alt+P                                                                   { power-off-monitors; }
    Ctrl+Alt+Delete                                                             { quit; }

    // ─── Applications ───

    // Terminal
    Mod+Return            hotkey-overlay-title="Open Terminal: Kitty"           { spawn "kitty"; }

    // Editor
    Mod+E                 hotkey-overlay-title="Open Text Editor: Zed"          { spawn "zeditor"; }

    // Browser
    Mod+B                 hotkey-overlay-title="Open Browser: Brave"            { spawn "brave"; }

    // File Manager
    Mod+X                 hotkey-overlay-title="Open File Manager: Nautilus"    { spawn "nautilus"; }

    // Password Manager
    Shift+Ctrl+1          hotkey-overlay-title="Toggle 1Password"               { spawn-sh "1password --toggle"; }
    Shift+Ctrl+Space      hotkey-overlay-title="Toggle 1Password Quick Access"  { spawn-sh "1password --quick-access"; }
    Shift+Ctrl+L          hotkey-overlay-title="Lock 1Password"                 { spawn-sh "1password --lock"; }

}
