// ────────────── Window & Layer Rules ──────────────
// Disable border background
// https://niri-wm.github.io/niri/FAQ.html#why-are-transparent-windows-tinted-why-is-the-borderfocus-ring-showing-up-through-semitransparent-windows
window-rule { draw-border-with-background false; }

// Rounded corners for a modern look.
window-rule {
    geometry-corner-radius  12
    clip-to-geometry        true
}

// Default terminal: Kitty — claim focus at startup (see focus race note below)
window-rule {
    match           app-id="kitty"
    open-on-output  "DP-1"
    open-focused    true
}

// Default browser: Brave — never steal focus on open; kitty stays focused
// even though brave (heavier) maps last in the startup race.
window-rule {
    match           app-id="brave-browser"
    open-on-output  "HDMI-A-1"
    open-focused    false
}

// 1Password: treat all windows as floating
window-rule {
    match           app-id="1password"
    open-on-output  "DP-1"
    open-floating   true
    open-focused    true
    shadow          { on; }
}
{{- if lookPath "noctalia" }}

// Noctalia: floating settings window
window-rule {
    match                 app-id="dev.noctalia.Noctalia"
    open-floating         true
    default-column-width  { fixed 1080; }
    default-window-height { fixed 920; }
}

// Config wallpaper
layer-rule {
    match                 namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
{{- end }}
