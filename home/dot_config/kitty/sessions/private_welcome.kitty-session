# kitty startup session — used at launch via `startup_session` in kitty.conf.
# Launch an interactive login shell tagged with KITTY_WELCOME=1; ~/.zshrc shows
# fastfetch once for that marker, then clears it. Running fastfetch from the
# shell (not a `sh -c` wrapper) makes its Shell module report zsh, not kitty.
launch --env KITTY_WELCOME=1 zsh -l
