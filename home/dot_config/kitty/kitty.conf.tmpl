## Color scheme
include                       ~/.config/kitty/themes/Tokyo-Night-Moon.conf
background_opacity            0.95

## Fonts
{{ if eq .chezmoi.os "linux" -}}
# Linux uses the plain "Nerd Font" variant at 12pt (HiDPI handled by compositor).
font_family                   family='JetBrainsMono Nerd Font' style=Regular
font_size                     12.0
{{ else if eq .chezmoi.os "darwin" -}}
# macOS uses the "Nerd Font Mono" variant at 15pt (Retina display scaling).
font_family                   family='JetBrainsMono Nerd Font Mono' style=Regular
font_size                     15.0
{{ end -}}
font_features                 none
disable_ligatures             always
italic_font                   auto
bold_font                     auto
bold_italic_font              auto

## Text cursor customization
cursor_shape                  block
cursor_shape_unfocused        hollow

## Scrollback
scrollback_lines              5000
scrollback_pager_history_size 10
scrollbar                     never

## Mouse
strip_trailing_spaces         smart

## Layouts
enabled_layouts               tall:bias=50;full_size=1;mirrored=false,stack

## Windows
hide_window_decorations       titlebar-only
inactive_text_alpha           0.25
remember_window_size          yes
remember_window_position      yes
window_padding_width          4
window_border_width           2

## Tab bar
tab_bar_min_tabs              1
tab_bar_edge                  bottom
tab_bar_style                 custom

## Advanced
shell_integration             no-cursor

## Startup
# run fastfetch in the first window at launch, then drop to the shell (see startup.session)
startup_session               ~/.config/kitty/sessions/welcome.kitty-session

## Keybinds
{{ $kbd := "ctrl+alt" -}}
{{ if eq .chezmoi.os "darwin" -}}
  {{ $kbd = "cmd+ctrl" -}}
{{ end -}}
# modifier is ctrl+alt on Linux, cmd+ctrl on macOS (leaves Option free for
# special chars on non-US layouts; both are clear of kitty's default binds)

# switch to specific layout
#map {{ $kbd }}+t goto_layout tall
#map {{ $kbd }}+s goto_layout stack

# switch to last layout
#map {{ $kbd }}+h last_used_layout

# switch to next layout
map {{ $kbd }}+l next_layout

# toggle stack layout (zoom)
map {{ $kbd }}+z toggle_layout stack

# toggle tall layout mirror
map {{ $kbd }}+m layout_action mirror toggle

# cycle tall layout bias (window width)
map {{ $kbd }}+b layout_action bias 33 50 66

# decrease tall layout full-height windows
map {{ $kbd }}+, layout_action decrease_num_full_size_windows

# increase tall layout full-height windows
map {{ $kbd }}+. layout_action increase_num_full_size_windows

# save window state to a session file; prompts for name, default dir: ~/.config/kitty/sessions/
map f1 save_as_session --use-foreground-process --base-dir ~/.config/kitty/sessions

# pick a session from ~/.config/kitty/sessions/ and open it in a new tab
# (goto_session focuses an already-open session or creates a new tab from the file)
map f4 goto_session ~/.config/kitty/sessions
